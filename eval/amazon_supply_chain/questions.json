{
  "meta": {
    "title": "Amazon 供应链标准手册 · AI 客服准确率测试题库",
    "source_doc": "amazon-supplier-manual-simplified-chinese.pdf",
    "source_doc_note": "亚马逊《供应链标准手册》简化中文版，2023 年 11 月更新，共 13 页（含附录 1-8）",
    "tenant": "星辰户外装备（star@demo.local）",
    "knowledge_base": "默认知识库",
    "employee": "默认客服",
    "version": "1.1",
    "created_at": "2026-09-23",
    "category_legend": {
      "A": "单点事实 —— 文档里一句话就能答，考的是「找得到」",
      "B": "数值与期限 —— 考的是「记不准就会答错」，最容易糊弄过去的一类",
      "C": "清单枚举 —— 考的是「漏不漏」",
      "D": "条件组合 —— 需要把两处以上的信息拼起来才能答对",
      "E": "否定与陷阱 —— 文档明确写了「不接受 / 不意味着 / 不是必须」，答反了就是高危错误",
      "F": "边界与例外 —— 只在特定国家、特定情形下成立的规则",
      "G": "口语化换问法 —— 同一知识点用供应商的真实口吻问，考检索鲁棒性",
      "H": "文档外问题（防编造）—— 手册里根本没有的答案，正确行为是承认没有而不是编",
      "I": "行为验证（非文档知识）—— 考转人工 / 拦截策略，附加项"
    },
    "check_type_legend": {
      "contains_all": "每个关键词组都要命中至少一个同义词",
      "contains_any_n": "关键词组命中数量达到 n 个即算通过（枚举题不要求一字不落）",
      "expect_fallback": "正确行为是兜底 / 转人工 / 明确说明查不到，而不是给出具体答案",
      "expect_canned": "应当命中系统预置话术（转人工 / 澄清 / 广告拦截）",
      "manual": "需人工判读，不参与自动统计"
    },
    "field_legend": {
      "must_not": "命中即判失败（已排除否定句误伤：不含「不」字的反义断言才放这里）",
      "review_if": "命中则标记「需人工复核」，不直接判失败 —— 用于容易误伤的编造类检查"
    },
    "scoring_note": "自动判分为关键词命中式，属于「下限判定」：判过的不代表表述完美，判不过的一定要人工看一眼回放。"
  },
