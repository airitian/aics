# ============================================================
# AICS 环境配置模板
# 复制为 .env 后填写。所有密钥只走环境变量，代码中不硬编码。
# ============================================================

# ---------- 基础 ----------
APP_NAME=AICS
ENV=dev
DEBUG=false
# SQLite 开箱即用；生产建议 PostgreSQL
DATABASE_URL=sqlite:///./aics.db

# 上线前必须修改：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=720

# 平台管理员（首次启动自动创建）
BOOTSTRAP_ADMIN_EMAIL=admin@aics.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345
# 是否创建两个演示租户（用于验证租户隔离），生产置 false
BOOTSTRAP_DEMO=true

# ---------- 对话模型（OpenAI 兼容接口） ----------
# LLM_PROVIDER=api 时启用真实模型；stub 仅用于本地跑通链路，会明确回「模型未配置」
LLM_PROVIDER=stub
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
# 推理模型（deepseek / o1 系）的思考 token 也算在这份预算里，且照常计费。
# 太小会把回答截成半句 —— 代码会检测 finish_reason=length 并记 warning，但不自动纠，
# 所以这里按推理模型给值。纯非推理模型可以降到 800。
LLM_MAX_TOKENS=1200
# 连续失败达到阈值后熔断：冷却期内直接降级转人工，不让每条客户消息都白等一轮退避
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN=15
# 备用端点：主端点挂掉时切换，避免全平台租户都无法发布/接待
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------- 向量模型（Embedding / 检索召回，OpenAI 兼容接口） ----------
# 生产必须设为 api。本项目使用 Gitee AI 模力方舟的 bge-m3。
EMBED_PROVIDER=local
EMBED_BASE_URL=https://ai.gitee.com/api/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
# 必须等于 EMBED_MODEL 的输出维度（bge-m3 = 1024）。集合维度一经创建即固定：
# 改了这里就必须删掉旧集合并重新入库（不同模型的向量不可混用）。
# 启动时会真打一次接口核对，配错直接写进启动日志。
EMBED_DIM=1024
EMBED_BATCH=32
EMBED_TIMEOUT=30
# 向量服务同样在公网：抖动退避重试，真故障熔断（冷却期内直接降级）
EMBED_RETRIES=3
EMBED_RETRY_DELAY=0.5
EMBED_BREAKER_THRESHOLD=3
EMBED_BREAKER_COOLDOWN=15

# ---------- 向量库 ----------
# db = 复用关系库做暴力检索（零额外依赖，小规模/离线开发可用）
# qdrant / pgvector = 生产
VECTOR_BACKEND=db
# Qdrant Cloud 形如 https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 集合由应用首次写入时自动创建，不需要手工建
QDRANT_COLLECTION=aics_chunks
# 云端向量库在公网，TLS 抖动会让单条消息降级，这里做退避重试把它吃掉
QDRANT_TIMEOUT=20
QDRANT_RETRIES=3
QDRANT_RETRY_DELAY=0.5
# 真故障时熔断，冷却期内直接降级（避免每条消息白等重试）
# 实测：不熔断时降级响应 ~1500ms，熔断后 5~12ms
QDRANT_BREAKER_THRESHOLD=3
QDRANT_BREAKER_COOLDOWN=15
PGVECTOR_TABLE=aics_vectors

# ---------- RAG ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
# 余弦相似度下限。**换模型 / 改 CHUNK_SIZE 都必须重新定标**，别沿用旧数。
# 且必须按「短查询 vs 真实切分块」来定，不能按「单句 vs 单句」来定（后者偏高约 0.2）。
# 实测 bge-m3：答案块得分下限 ~0.47，噪音上限 ~0.44 → 0.45。
# 跑 python verify_embedding.py 会打印你当前语料上的实测值并给出建议。
MIN_SCORE=0.45

# ---------- 边界值（对应 PRD 第八章） ----------
PERSONA_MAX_CHARS=20000
PERSONA_VAR_MAX_CHARS=200
MAX_EMPLOYEES_PER_TENANT=10
MAX_KB_PER_TENANT=20
MAX_DOCS_PER_KB=500
MAX_KB_BYTES=1073741824
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=10
MAX_VERSIONS_KEPT=10
AUTO_SAVE_INTERVAL_SEC=30
ASR_MAX_SECONDS=60
AUTO_STOP_THRESHOLD=3
CLARIFY_ROUNDS=1
BATCH_TEST_MAX=50
PLAYGROUND_KEEP_DAYS=7
INSIGHT_MIN_SAMPLES=30
AUDIT_KEEP_DAYS=180

# ---------- 重排 Rerank（二阶段检索）----------
# off = 纯向量排序；api = 粗排后交交叉编码器精排（实测 R@1 69.3%→82.7%）。
# 增强项：失败自动降级回向量排序，不影响会话。
RERANK_PROVIDER=off
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CANDIDATES=20
RERANK_RECALL_MIN_SCORE=0.15
RERANK_MIN_SCORE=0.05
RERANK_TIMEOUT=20
RERANK_RETRIES=2

# ---------- 图片识别 Vision（入库时把图读成文字）----------
# off = 保留「图中内容无法提取」占位说明；api = 上传时抽图送视觉模型转写。
# 只在入库时用一次，检索链路不变，不需要多模态 embedding / 换向量库。
# 注意视觉模型可能认错数字，开启后建议抽查 document_assets 的描述。
VISION_PROVIDER=off
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT=120
VISION_MAX_TOKENS=2000
VISION_MAX_IMAGES=20
VISION_CONCURRENCY=4
# 原文件与抽图落盘目录（相对启动目录）
ASSETS_DIR=assets

# ---------- per-tenant 限流与配额 ----------
TENANT_RPM=120
TENANT_CONCURRENT=8
TENANT_DAILY_TOKENS=2000000
